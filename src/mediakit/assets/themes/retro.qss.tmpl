QWidget {
    background-color: $bg;
    color: $ink;
    font-family: "Consolas", "Courier New";
    font-size: 13px;
}

#Sidebar {
    background-color: $panel;
    border-right: 1px solid $line;
}

#NavButton {
    background-color: transparent;
    color: $muted;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 13px 18px;
    text-align: left;
    font-weight: bold;
}
#NavButton:hover   { background-color: $hover; color: $ink; }
#NavButton:pressed { background-color: $panel; }
#NavButton:checked {
    background-color: $panel2;
    color: $amber;
    border-left: 3px solid $amber;
}

#ScreenTitle    { color: $amber; font-size: 27px; font-weight: bold; }
#ScreenSubtitle { color: $muted; font-size: 12px; }

#FooterLabel {
    color: $faint;
    font-size: 10px;
    font-weight: bold;
    padding: 12px 18px 6px 18px;
    border-top: 1px solid $line;
}
#LangButton {
    background-color: transparent;
    color: $muted;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 9px 18px;
    text-align: left;
    font-weight: bold;
}
#LangButton:hover   { background-color: $hover; color: $ink; }
#LangButton:checked {
    background-color: $panel2;
    color: $amber;
    border-left: 3px solid $amber;
}
#ThemeButton {
    background-color: transparent;
    color: $amber;
    border: none;
    border-left: 3px solid $amber;
    border-radius: 0px;
    padding: 9px 18px;
    margin-top: 4px;
    text-align: left;
    font-weight: bold;
}
#ThemeButton:hover { background-color: $hover; }


/* ================= Tool hub (cards) ================= */
QScrollArea#HubScroll, QWidget#HubGrid,
QScrollArea#TileStrip, QScrollArea#TileStrip > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#ToolCard {
    background: $panel;
    border: 1px solid $line;
    border-radius: 10px;
}
QFrame#ToolCard:hover {
    background: $hover;
    border-color: $amber;
}
QFrame#ToolCard:focus {
    border-color: $amber;
}
QFrame#ToolCard:disabled {
    background: $bg;
    border-style: dashed;
}
QFrame#ToolCard QLabel, QFrame#ToolCard GlyphIcon { background: transparent; }
QLabel#ToolCardTitle {
    color: $ink;
    font-size: 15px;
    font-weight: 700;
}
QLabel#ToolCardTitle:disabled { color: $muted; }
QLabel#ToolCardDesc {
    color: $muted;
    font-size: 12px;
}
QLabel#SoonBadge {
    color: $muted;
    border: 1px solid $line;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 10px;
    letter-spacing: 1px;
}

GlyphIcon {
    color: $ink;
    qproperty-accent: $amber;
}

/* ================= Tool page ================= */
QPushButton#BackButton {
    background: transparent;
    color: $muted;
    border: none;
    padding: 4px 0;
    text-align: left;
}
QPushButton#BackButton:hover { color: $amber; }

QLabel#SectionLabel {
    color: $muted;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

ChoiceTile {
    color: $ink;
    qproperty-accent: $amber;
    qproperty-line: $line;
    qproperty-muted: $muted;
    qproperty-panel: $panel;
}

QPushButton#SegmentButton {
    background: $panel2;
    color: $muted;
    border: 1px solid $line;
    padding: 6px 14px;
}
QPushButton#SegmentButton:checked {
    color: $bg;
    background: $amber;
    border-color: $amber;
}
QPushButton#SegmentButton:hover:!checked { color: $ink; border-color: $amber; }

CropCanvas {
    background: $panel;
    border: 1px solid $line;
    qproperty-accent: $amber;
}

/* ================= Shared tool controls =================
   BatchToolScreen matches every tool (type selectors include subclasses).
   Replaces the old ImageConvertScreen-scoped rules. */
QLabel#ScreenTitle {
    color: $amber;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#Muted  { color: $muted; }
QLabel#Status { color: $ink; }

QListWidget#FileList {
    background: $panel;
    border: 1px solid $line;
    color: $ink;
    padding: 4px;
}
/* while files are dragged over the tool page */
QListWidget#FileList[dropTarget="true"] {
    border: 2px dashed $amber;
    background: $panel2;
}
QListWidget#FileList::item          { padding: 4px 6px; border-radius: 4px; }
QListWidget#FileList::item:selected { background: $hover; color: $amber; }
QListWidget#FileList::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid $line;
    background: $panel2;
}
QListWidget#FileList::indicator:checked { background: $amber; border-color: $amber; }

QProgressBar#Progress {
    background: $panel2;
    border: 1px solid $line;
    height: 14px;
    text-align: center;
    color: $muted;
}
QProgressBar#Progress::chunk { background: $amber; }

QPushButton#PrimaryButton {
    background: $amber;
    color: $bg;
    border: none;
    padding: 8px 22px;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover    { background: $ink; }
QPushButton#PrimaryButton:disabled { background: $faint; color: $panel; }

BatchToolScreen QPushButton,
BatchToolScreen QComboBox,
BatchToolScreen QSpinBox {
    background: $panel2;
    color: $ink;
    border: 1px solid $line;
    padding: 6px 12px;
}
BatchToolScreen QPushButton:hover,
BatchToolScreen QComboBox:hover,
BatchToolScreen QSpinBox:hover { background: $hover; border-color: $amber; }
BatchToolScreen QPushButton:disabled,
BatchToolScreen QComboBox:disabled,
BatchToolScreen QSpinBox:disabled { color: $faint; border-color: $line; }
BatchToolScreen QComboBox QAbstractItemView {
    background: $panel;
    color: $ink;
    border: 1px solid $line;
    selection-background-color: $hover;
}
BatchToolScreen QCheckBox          { color: $ink; }
BatchToolScreen QCheckBox:disabled { color: $faint; }
BatchToolScreen QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid $line;
    background: $panel2;
}
BatchToolScreen QCheckBox::indicator:checked { background: $amber; border-color: $amber; }
BatchToolScreen QSlider::groove:horizontal { height: 3px; background: $line; }
BatchToolScreen QSlider::handle:horizontal { background: $amber; width: 10px; margin: -5px 0; }
BatchToolScreen QLabel { color: $ink; }


/* ================= 1c: metadata + watermark ================= */
QLabel#InspectorBox {
    background: $panel;
    border: 1px solid $line;
    color: $ink;
    padding: 10px 12px;
}
QLabel#PreviewBox {
    background: $panel;
    border: 1px solid $line;
    color: $muted;
}
BatchToolScreen QLineEdit {
    background: $panel2;
    color: $ink;
    border: 1px solid $line;
    padding: 6px 8px;
    selection-background-color: $amber;
    selection-color: $bg;
}
BatchToolScreen QLineEdit:focus    { border-color: $amber; }
BatchToolScreen QLineEdit:disabled { color: $faint; }
